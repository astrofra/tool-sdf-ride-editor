# Minimal line-based scene format for the first native slice.
# This file is generated by save_scene_file and remains fully editable.
scene frame_006_blockout
bounds -40 -6 -20 46 48 100
cell_size 1
meshing_mode marching_tetrahedra

box add ground_slab 0 -2 0 50 2 50
box add left_tower -36 18 18 7 18 7
box add left_catwalk_mass -29 30 10 4 2 4
box add right_tower 21 22 15 10 22 12
box add right_wall 28 8 38 14 8 30
box add central_rear_mass 0 14 56 6 14 10
box add left_background_mass -8 10 40 4 10 8
box add center_plinth 0 3 26 3 3 3
box add right_plinth 10 2 24 2 2 2
box add left_marker_head -20 7 8 2.5 3 2.5
box add left_marker_stem -20 2 8 1 2 1
box add debris_slab -8 1 20 2 1 2
box add box 6 1 -18 5 5 5

noise_displace_masked left_tower_top_edges left_tower 0.75 0.180000007 17 3 top_edges 4
noise_displace_masked right_tower_edges right_tower 0.699999988 0.159999996 29 3 edges 3.5
noise_displace_masked rear_mass_top central_rear_mass 0.550000012 0.109999999 43 2 top 4.5
noise_displace_masked left_background_bottom left_background_mass 0.449999988 0.200000003 61 2 bottom 3
noise_displace_masked catwalk_all left_catwalk_mass 0.25 0.280000001 73 2 all 1.5

box_cut left_tower_opening left_tower 0 2 0 2 4 2
box_cut right_tower_opening right_tower -5 -2 -2 1.5 4 1.5

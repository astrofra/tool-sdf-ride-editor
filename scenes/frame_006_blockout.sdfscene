# Minimal line-based scene format for the first native slice.
# Syntax:
#   scene <name>
#   bounds <minx> <miny> <minz> <maxx> <maxy> <maxz>
#   cell_size <value>
#   box <add|subtract> <name> <tx> <ty> <tz> <hx> <hy> <hz> [material_id]
#   noise_displace_masked <name> <target_box_name> <amplitude> <frequency> <seed> <octaves> <mask> <mask_width>
#   box_cut <name> <target_box_name> <tx> <ty> <tz> <hx> <hy> <hz>

scene frame_006_blockout
bounds -36 -4 -16 42 42 96
cell_size 1.0

box add ground_slab 0 -2 40 32 2 52
box add left_tower -18 18 18 7 18 7
box add left_catwalk_mass -13 30 18 4 2 4
box add right_tower 21 22 15 10 22 12
box add right_wall 28 8 38 14 8 30
box add central_rear_mass 0 14 56 6 14 10
box add left_background_mass -8 10 40 4 10 8
box add center_plinth 0 3 26 3 3 3
box add right_plinth 10 2 24 2 2 2
box add left_marker_head -20 7 8 2.5 3 2.5
box add left_marker_stem -20 2 8 1 2 1
box add debris_slab -8 1 20 2 1 2

# Mask demo:
#   top_edges on left_tower
#   edges on right_tower
#   top on central_rear_mass
#   bottom on left_background_mass
#   all on left_catwalk_mass
noise_displace_masked left_tower_top_edges left_tower 0.75 0.18 17 3 top_edges 4.0
noise_displace_masked right_tower_edges right_tower 0.70 0.16 29 3 edges 3.5
noise_displace_masked rear_mass_top central_rear_mass 0.55 0.11 43 2 top 4.5
noise_displace_masked left_background_bottom left_background_mass 0.45 0.20 61 2 bottom 3.0
noise_displace_masked catwalk_all left_catwalk_mass 0.25 0.28 73 2 all 1.5

box_cut left_tower_opening left_tower 0 2 0 2 4 2
box_cut right_tower_opening right_tower -5 -2 -2 1.5 4 1.5
